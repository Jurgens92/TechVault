# Django Settings
# IMPORTANT: Generate a secure SECRET_KEY for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# SECURITY WARNING: Set DEBUG=False in production!
DEBUG=False

# Add your production domain(s) here
ALLOWED_HOSTS=localhost,127.0.0.1

# Environment: development, staging, or production
# IMPORTANT: Set to "production" for live deployments!
# - "development" uses SQLite database
# - "production" uses PostgreSQL database
ENVIRONMENT=development

# Database (use strong passwords in production)
DB_NAME=techvault
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# CORS - Update with your production frontend URL
# IMPORTANT: Do not use CORS_ALLOW_ALL_ORIGINS=true in production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Settings
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Optional security settings
# Django admin (/admin/) signs in with a password only - it bypasses 2FA and account
# lockout - so it is disabled in production unless you turn it on here.
ENABLE_DJANGO_ADMIN=False

# Number of reverse proxies in front of the app (1 for the standard nginx setup).
# Used to work out the real client IP for rate limiting and the audit log.
NUM_PROXIES=1
TRUST_PROXY_HEADERS=True

# Extra origins allowed to make authenticated requests (comma separated), e.g. when
# the frontend is served from a different domain than the API.
# CSRF_TRUSTED_ORIGINS=https://techvault.example.com
